# Required: Get these from https://api.slack.com/apps → your app
# Bot token: OAuth & Permissions → Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-...

# App token: Basic Information → App-Level Tokens (starts with xapp-)
SLACK_APP_TOKEN=xapp-...

# Optional: Root folder containing your projects (defaults to ~/projects)
# CLAUDE_PROJECTS_DIR=~/projects

# Optional: Comma-separated list of allowed Claude tools (empty = all tools)
# CLAUDE_ALLOWED_TOOLS=Read,Write,Bash
